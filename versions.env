# Single source of truth for what gets built. Sourced by the Makefile (as
# make variables) and by scripts/*.sh (as shell variables). Keep it to plain
# KEY=VALUE lines: no quotes, no spaces around '=', no shell expansion.
#
# When bumping OKD_VERSION, also re-pin the submodules under upstream/ to the
# commits recorded in the new release (see `make print-upstream-commits`) and
# regenerate rpms/okd-el9.lock (`make rpms-lock`).

# ---------------------------------------------------------------------------
# Upstream OKD release we rebuild
# ---------------------------------------------------------------------------
OKD_VERSION=4.22.0-okd-scos.10
OKD_MINOR=4.22
UPSTREAM_RELEASE_IMAGE=quay.io/okd/scos-release:4.22.0-okd-scos.10
# Suffix appended to OKD_VERSION for the rebuilt release name (semver prerelease).
RELEASE_SUFFIX=c9s

# `oc` used for release assembly and image extraction. Pinned to the `cli`
# image of UPSTREAM_RELEASE_IMAGE (CentOS Stream 9 based, so it runs on v2).
# Only used when no `oc` binary is found on PATH.
OC_IMAGE=quay.io/okd/scos-content@sha256:d88c470575302ef7d29a80cbc77fe9b1636801ff08b3db562795fc976a062029

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# Repository prefix that every image is pushed under, e.g. ghcr.io/nobidev/okd-c9s
REGISTRY=ghcr.io/nobidev/okd-c9s

# ---------------------------------------------------------------------------
# Node OS (SCOS 9 / CentOS Stream 9, baseline x86-64-v2)
# ---------------------------------------------------------------------------
# rhel-coreos-config variant used for the base image
SCOS_VARIANT=c9s
# Value of the io.openshift.os.streamclass label. The OKD 4.22 MCO hard-codes
# "centos-10" as the only (and default) stream for SCOS builds
# (pkg/osimagestream/streams.go), so the c9s node image must carry that label to
# be selected. See docs/design.md.
STREAM_CLASS=centos-10

# Public el9 builds of the OpenShift node RPMs (cri-o, kubelet, oc, ...).
# This repository only keeps the newest builds; rpms/okd-el9.lock pins the
# exact NVRs + sha256 that get installed.
OKD_EL9_RPM_REPO=https://mirror.openshift.com/pub/openshift-v4/x86_64/dependencies/rpms/4.22-el9-beta

# ---------------------------------------------------------------------------
# Boot images (ISO / PXE / raw / qcow2) used to install nodes
# ---------------------------------------------------------------------------
# SCOS 9 boot images published by the CoreOS pipeline. Built from the same
# rhel-coreos-config commit pinned in upstream/rhel-coreos-config.
SCOS9_BOOTIMAGE_BUILD=9.0.20261110-0
SCOS9_BOOTIMAGE_BASEURL=https://rhcos.mirror.openshift.com/art/storage/prod/streams/c9s/builds

# ---------------------------------------------------------------------------
# Base images for rebuilt payload components
# ---------------------------------------------------------------------------
C9S_BASE_IMAGE=quay.io/centos/centos:stream9
