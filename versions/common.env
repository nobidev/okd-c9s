# Settings shared by every OKD minor. Per-minor settings live in
# versions/<minor>.env; OKD_MINOR selects which one is loaded (scripts/lib.sh).
# Plain KEY=VALUE lines only: no quotes, no spaces around '=', no expansion.
# Anything here can be overridden from the environment / make command line.

# Minor built when OKD_MINOR is not set
DEFAULT_OKD_MINOR=4.22

# Repository prefix that every image is pushed under
REGISTRY=ghcr.io/nobidev/okd-c9s

# Suffix appended to OKD_VERSION for the rebuilt release name (semver
# prerelease). Bump the trailing counter (c9s.1 -> c9s.2) whenever a rebuild
# must be distinguishable from an already published release of the same
# OKD_VERSION; it renames every minor. c9s.1: per-minor boot image pins
# (Ignition spec fix).
RELEASE_SUFFIX=c9s.1

# ---------------------------------------------------------------------------
# Node OS: SCOS 9 (CentOS Stream CoreOS 9, x86-64-v2 baseline), shared by all
# minors. Built from upstream/rhel-coreos-config.
# ---------------------------------------------------------------------------
SCOS_VARIANT=c9s
# io.openshift.os.streamclass label for 4.22 (build-args-4.22-c9s.conf). The
# MCO's OSImageStream feature is disabled for SCOS in 4.21+, so this is only
# kept for parity with upstream's SCOS images.
STREAM_CLASS=centos-10

# SCOS 9 boot images (ISO / PXE / raw / qcow2) published by the CoreOS
# pipeline. The build is pinned per minor (SCOS9_BOOTIMAGE_BUILD in
# versions/<minor>.env, never here: values set first win) because its Ignition
# must request a config spec that the minor's machine-config-server serves;
# `make check-bootimages` enforces that.
SCOS9_BOOTIMAGE_BASEURL=https://rhcos.mirror.openshift.com/art/storage/prod/streams/c9s/builds

# Base image for rebuilt payload components
C9S_BASE_IMAGE=quay.io/centos/centos:stream9
