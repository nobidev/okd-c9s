# OKD 4.22 (upstream node OS: SCOS 10). Submodules: upstream/4.22/*
OKD_VERSION=4.22.0-okd-scos.10
UPSTREAM_RELEASE_IMAGE=quay.io/okd/scos-release:4.22.0-okd-scos.10
# `cli` image of UPSTREAM_RELEASE_IMAGE (CentOS Stream 9); used when no oc is on PATH
OC_IMAGE=quay.io/okd/scos-content@sha256:d88c470575302ef7d29a80cbc77fe9b1636801ff08b3db562795fc976a062029
# Public el9 builds of cri-o / kubelet / oc, pinned in rpms/okd-el9-4.22.lock
OKD_EL9_RPM_REPO=https://mirror.openshift.com/pub/openshift-v4/x86_64/dependencies/rpms/4.22-el9-beta
# Payload components that carry the coreos-bootimages ConfigMap
BOOTIMAGES_COMPONENTS=installer installer-artifacts
# SCOS 9 boot image (live ISO for machine-os-images, coreos-bootimages stream).
# Its Ignition must request a spec that this minor's MCS and the previous
# minor's MCS serve (checked by `make check-bootimages`). 9.0.20260324-0 is the
# newest c9s build with ignition-2.25.1 (Accept version=3.5.0); later builds ship
# Ignition >= 2.26 (version=3.6.0), which the 4.20/4.21 MCS rejects with 400.
SCOS9_BOOTIMAGE_BUILD=9.0.20260324-0
# Releases a cluster may still run while this minor's boot image is already
# served (CVO rolls metal3 / machine-os-images at runlevel 31, the MCO at 80):
# their MCS must accept this boot image too. Add the previous upstream release
# here when OKD_VERSION is bumped within the minor.
UPGRADE_FROM_RELEASES=quay.io/okd/scos-release:4.21.0-okd-scos.11
