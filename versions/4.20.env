# OKD 4.20 (upstream node OS: SCOS 10). Submodules: upstream/4.20/*
OKD_VERSION=4.20.0-okd-scos.17
UPSTREAM_RELEASE_IMAGE=quay.io/okd/scos-release:4.20.0-okd-scos.17
OC_IMAGE=quay.io/okd/scos-content@sha256:9028017f0a45e7a32f532bfe4b173a7d9d9dc9fd00361a10557f8e21f02eea9c
OKD_EL9_RPM_REPO=https://mirror.openshift.com/pub/openshift-v4/x86_64/dependencies/rpms/4.20-el9-beta
BOOTIMAGES_COMPONENTS=installer installer-artifacts installer-altinfra
# SCOS 9 boot image (live ISO for machine-os-images, coreos-bootimages stream).
# Its Ignition must request a spec that this minor's MCS and the previous
# minor's MCS serve (checked by `make check-bootimages`). 9.0.20260324-0 is the
# newest c9s build with ignition-2.25.1 (Accept version=3.5.0); later builds ship
# Ignition >= 2.26 (version=3.6.0), which the 4.20/4.21 MCS rejects with 400.
SCOS9_BOOTIMAGE_BUILD=9.0.20260324-0
# Releases a cluster may still run while this minor's boot image is already
# served (CVO rolls metal3 / machine-os-images at runlevel 31, the MCO at 80):
# their MCS must accept this boot image too. Add the previous upstream release
# here when OKD_VERSION is bumped within the minor.
UPGRADE_FROM_RELEASES=quay.io/okd/scos-release:4.19.0-okd-scos.19
