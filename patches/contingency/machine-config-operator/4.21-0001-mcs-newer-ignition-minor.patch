diff --git a/pkg/server/api.go b/pkg/server/api.go
index 9171d1bf..dbd75d34 100644
--- a/pkg/server/api.go
+++ b/pkg/server/api.go
@@ -12,6 +12,7 @@ import (
 
 	"github.com/clarketm/json"
 	"github.com/coreos/go-semver/semver"
+	ign3types "github.com/coreos/ignition/v2/config/v3_5/types"
 	"k8s.io/klog/v2"
 	"sigs.k8s.io/controller-runtime/pkg/certwatcher"
 
@@ -290,6 +291,13 @@ func detectSpecVersionFromAcceptHeader(acceptHeader string) (*semver.Version, er
 		}
 		version, err := ctrlcommon.IgnitionConverterSingleton().GetSupportedMinorVersion(*reqVersion)
 		if err != nil {
+			// Ignition is backwards compatible within a spec major version:
+			// a client asking for a newer minor than we support (e.g. spec
+			// 3.6.0 from Ignition 2.26+) can parse our newest spec, so serve
+			// that instead of failing. Backport of the 4.22 behaviour.
+			if reqVersion.Major == ign3types.MaxVersion.Major && reqVersion.Minor > ign3types.MaxVersion.Minor {
+				return &ign3types.MaxVersion, nil
+			}
 			return nil, fmt.Errorf("unsupported Ignition version in Accept header: %s", acceptHeader)
 		}
 		return &version, nil
diff --git a/pkg/server/api_newer_minor_test.go b/pkg/server/api_newer_minor_test.go
