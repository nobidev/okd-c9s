--- /dev/null
+++ b/pkg/server/api_newer_minor_test.go
@@ -0,0 +1,25 @@
+package server
+
+import (
+	"testing"
+
+	"github.com/coreos/go-semver/semver"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// Ignition 2.26+ requests spec 3.6.0; the server must fall back to its newest
+// spec 3 version instead of answering 400.
+func TestDetectSpecVersionNewerSpec3Minor(t *testing.T) {
+	for _, accept := range []string{
+		"application/vnd.coreos.ignition+json;version=3.6.0, */*;q=0.1",
+		"application/vnd.coreos.ignition+json;version=3.9.0, */*;q=0.1",
+	} {
+		version, err := detectSpecVersionFromAcceptHeader(accept)
+		require.NoError(t, err, accept)
+		assert.Equal(t, semver.New("3.5.0"), version, accept)
+	}
+
+	_, err := detectSpecVersionFromAcceptHeader("application/vnd.coreos.ignition+json;version=4.0.0, */*;q=0.1")
+	assert.Error(t, err)
+}
