[submodule "upstream/rhel-coreos-config"]
	path = upstream/rhel-coreos-config
	url = https://github.com/coreos/rhel-coreos-config
	branch = main
[submodule "upstream/os"]
	path = upstream/os
	url = https://github.com/openshift/os
	branch = release-4.22
[submodule "upstream/driver-toolkit"]
	path = upstream/driver-toolkit
	url = https://github.com/openshift/driver-toolkit
	branch = release-4.22
[submodule "upstream/machine-os-images"]
	path = upstream/machine-os-images
	url = https://github.com/openshift/machine-os-images
	branch = release-4.22
